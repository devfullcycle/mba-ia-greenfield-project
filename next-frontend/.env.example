API_URL=http://host.docker.internal:3000
SESSION_PASSWORD=change-me-to-at-least-32-characters-long

# QA page /qa/phase-03 (dev only). Copy the tokens from
# nestjs-project/http/phase-03-manual/http-client.env.json (ownerToken / otherToken).
QA_OWNER_TOKEN=
QA_OTHER_TOKEN=
# Presigned URLs point to localhost:9000; from the container dial the host's MinIO.
QA_STORAGE_CONNECT=host.docker.internal:9000
# Sample video mounted by compose.yaml (../nestjs-project/test/video/fixtures -> /fixtures).
QA_SAMPLE_PATH=/fixtures/sample.mp4
