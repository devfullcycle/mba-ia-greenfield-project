{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-project/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "mail/templates/**/*.hbs",
        "watchAssets": true
      }
    ],
    "webpack": true,
    "tsConfigPath": "apps/nestjs-project/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-project",
  "projects": {
    "nestjs-project": {
      "type": "application",
      "root": "apps/nestjs-project",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-project/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-project/tsconfig.app.json"
      }
    },
    "video-worker": {
      "type": "application",
      "root": "apps/video-worker",
      "entryFile": "main",
      "sourceRoot": "apps/video-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/video-worker/tsconfig.app.json"
      }
    }
  }
}