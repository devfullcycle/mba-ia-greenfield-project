{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/setup-test-env.ts",
    "dotenv/config"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/test/video/"
  ]
}
